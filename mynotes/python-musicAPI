import requests

class MusicPlayerAPI:
    def searchSongs(self, kw):
        keyword = (kw or "").strip()
        if not keyword:
            return []
        items = []
        try:
            response = requests.get("https://api.deezer.com/search", params={"q": keyword}, timeout=10)
            data = response.json()
            for song in data.get("data", [])[:20]:
                items.append({
                    "id": f"deezer:{song.get('id')}",
                    "title": song.get("title") or "",
                    "artist": (song.get("artist") or {}).get("name") or "",
                    "cover": (song.get("album") or {}).get("cover_medium") or "",
                    "duration": 30,
                    "url": song.get("preview") or ""
                })
        except Exception:
            pass
        if items:
            return items
        try:
            response = requests.get(
                "https://itunes.apple.com/search",
                params={"term": keyword, "media": "music", "limit": 20},
                timeout=10
            )
            data = response.json()
            for song in data.get("results", []):
                items.append({
                    "id": f"itunes:{song.get('trackId')}",
                    "title": song.get("trackName") or "",
                    "artist": song.get("artistName") or "",
                    "cover": song.get("artworkUrl100") or "",
                    "duration": 30,
                    "url": song.get("previewUrl") or ""
                })
        except Exception:
            pass
        return items

    def getSongUrl(self, songId):
        sid = str(songId)
        try:
            if sid.startswith("itunes:"):
                item_id = sid.split(":", 1)[1]
                response = requests.get("https://itunes.apple.com/lookup", params={"id": item_id}, timeout=10)
                data = response.json()
                for song in data.get("results", []):
                    preview_url = song.get("previewUrl")
                    if preview_url:
                        return {"id": sid, "url": preview_url}
            else:
                track_id = sid.split(":", 1)[1] if sid.startswith("deezer:") else sid
                response = requests.get(f"https://api.deezer.com/track/{track_id}", timeout=10)
                data = response.json()
                if data.get("preview"):
                    return {"id": sid, "url": data.get("preview")}
        except Exception:
            pass
        return None



